<!--
  Tabula Rasa: общие стили окон (главное окно, файлы с Диска, диалоги).
  Цвета сюда не зашиты: кисти Bg, Surface, Accent, Success, Warning и т.д. кладёт Set-UiPalette из lib\gui.ps1
  (фирменная палитра, светлая и тёмная). Сетка 8 px, кнопки и поля — 32 px, скругление: элементы 6, карточки 8.
  У каждого текста цвет задаётся явно или наследуется от окна/списка с Foreground = Text: системный чёрный по умолчанию
  в тёмной теме нечитаем. Контраст всех видимых текстов проверяется в CI (tests\smoke.ps1).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="Vis"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Focus}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== текст ===== -->
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- шкала Fluent: заголовок экрана 28, подзаголовок 20 (Title), основной 14, подписи 12 (Caption) -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== кнопки ===== -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- кнопка-переключатель «⚙ мои настройки / можно с настройками» в карточке -->
    <Style x:Key="ConfigBadge" TargetType="Button">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentText}"/>
        <Setter Property="ToolTip" Value="Доступна установка с сохранёнными настройками. Нажмите, чтобы включить"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="8,0,10,0" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock x:Name="T" Text="можно с настройками" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ConfigOn}" Value="True">
                            <Setter TargetName="T" Property="Text" Value="мои настройки"/>
                            <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConfigOn}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                <Setter Property="ToolTip" Value="Установка с сохранёнными настройками. Нажмите, чтобы выбрать чистую установку"/>
            </DataTrigger>
            <!-- файла настроек нет нигде: значок серый, клик только выделяет карточку -->
            <DataTrigger Binding="{Binding ConfigAvailable}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                <Setter Property="ToolTip" Value="Сохранённые настройки недоступны: подключите «Мои данные»"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- маленькая кнопка-значок: переименовать/удалить в меню сохранений, закрыть уведомление -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- статичные метки в карточке: мастер, необратимо, сайт -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Background" Value="{DynamicResource PillBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
    </Style>
    <Style x:Key="DangerPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}"/>
    </Style>

    <!-- подсказка клавиши: Ctrl+F, Esc, Пробел -->
    <Style x:Key="Kbd" TargetType="Border">
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="Background" Value="{DynamicResource Control}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
    </Style>

    <!-- ===== поля ===== -->
    <!-- журнал выполнения: многострочный, на всю высоту, текст сверху, перенос и вертикальная прокрутка
         (общий стиль TextBox ниже — однострочное поле 32 px: в нём журнал превращался в одну строку) -->
    <Style x:Key="LogBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="B" Property="BorderThickness" Value="1,1,1,2"/>
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource Surface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- пароль Windows для временного автоматического входа (Read-UiPassword): вид как у поля ввода -->
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="B" Property="BorderThickness" Value="1,1,1,2"/>
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== галочки и радиокнопки ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                                Background="{DynamicResource Control}" BorderBrush="{DynamicResource ControlStrong}" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Mark" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentFg}" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter x:Name="C" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="C" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="C" Property="Opacity" Value="0.6"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <!-- отмечена и заблокирована (установленная программа): нейтральная заливка, галочка видна -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlStrong}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ControlStrong}"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Surface}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,6,0,0">
                            <Ellipse x:Name="Ring" Fill="{DynamicResource Control}" Stroke="{DynamicResource ControlStrong}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource AccentFg}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- сегменты «План | Применить» -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- тонкая полоса прогресса прогона: дорожка и заливка акцентом -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource PillBg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== списки ===== -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- карточка в центре -->
    <Style x:Key="CardItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,0,6" MinHeight="56" SnapsToDevicePixels="True" TextElement.Foreground="{DynamicResource Text}">
                        <Grid Margin="8,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="Check" Focusable="False" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                      HorizontalAlignment="Center" ToolTip="Отметить (пробел)" ToolTipService.ShowOnDisabled="True"/>
                            <!-- плитка программы: значок из exe, если установлена, иначе монограмма -->
                            <Grid Grid.Column="1" Width="32" Height="32" Margin="4,0,4,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasTile, Converter={StaticResource Vis}}">
                                <Border CornerRadius="6" Background="{Binding MonoBrush}">
                                    <TextBlock Text="{Binding Monogram}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="6" Background="{DynamicResource Surface}" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}">
                                    <Image Source="{Binding IconSource}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,8,8,8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <!-- до двух строк, дальше многоточие; полный текст — справа -->
                                <TextBlock Text="{Binding Desc}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32"/>
                                <!-- пометки — отдельной строкой с переносом: название и описание получают всю ширину карточки -->
                                <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource ConfigBadge}" Margin="0,4,6,0" Tag="cfg" AutomationProperties.Name="С моими настройками"
                                        Visibility="{Binding HasConfig, Converter={StaticResource Vis}}"/>
                                <Border Style="{StaticResource Pill}" Margin="0,4,6,0" Visibility="{Binding Interactive, Converter={StaticResource Vis}}"
                                        ToolTip="Тихая установка невозможна: откроется мастер установки">
                                    <TextBlock Text="мастер" VerticalAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource DangerPill}" Margin="0,4,6,0" Visibility="{Binding Irreversible, Converter={StaticResource Vis}}"
                                        ToolTip="Не отменяется через undo.ps1, только точкой восстановления">
                                    <TextBlock Text="необратимо" VerticalAlignment="Center"/>
                                </Border>
                                <!-- зависимость (Э8): отмечена, потому что нужна другой отмеченной программе -->
                                <Border Style="{StaticResource Pill}" Margin="0,4,6,0" Visibility="{Binding HasNeededBy, Converter={StaticResource Vis}}"
                                        ToolTip="Требуется для отмеченной программы">
                                    <TextBlock Text="{Binding NeededByText}" VerticalAlignment="Center"/>
                                </Border>
                                <!-- действие над установленной (Э7): будет обновлена / переустановка / будет удалена -->
                                <Border x:Name="ActionPill" Style="{StaticResource Pill}" Margin="0,4,6,0" Visibility="{Binding HasAction, Converter={StaticResource Vis}}"
                                        Background="{DynamicResource AccentSoft}">
                                    <TextBlock x:Name="ActionText" Text="{Binding ActionText}" VerticalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
                                </Border>
                                <!-- статус на этом компьютере: установлено / обновление / не установлено; у твиков — применено -->
                                <Border x:Name="StatusPill" Style="{StaticResource Pill}" Margin="0,4,6,0" Visibility="{Binding HasStatus, Converter={StaticResource Vis}}">
                                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,4,6,0" Visibility="{Binding IsMine, Converter={StaticResource Vis}}"
                                        ToolTip="Программа из собственного каталога («Мои данные»)">
                                    <TextBlock Text="мой каталог" VerticalAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,4,6,0" Visibility="{Binding OpenSource, Converter={StaticResource Vis}}"
                                        ToolTip="Открытый исходный код">
                                    <TextBlock Text="Open source" VerticalAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,4,6,0" Visibility="{Binding IsWeb, Converter={StaticResource Vis}}"
                                        ToolTip="Загружается с официального сайта с проверкой цифровой подписи">
                                    <TextBlock Text="сайт" VerticalAlignment="Center"/>
                                </Border>
                            </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding StatusKind}" Value="update">
                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource AccentText}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="installed">
                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SuccessSoft}"/>
                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Success}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="partial">
                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource WarningSoft}"/>
                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Warning}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                            <Setter TargetName="Check" Property="ToolTip" Value="Программа установлена. Действия с ней (обновить, переустановить, удалить, применить мои настройки) — в подробностях справа"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Action}" Value="remove">
                            <Setter TargetName="ActionPill" Property="Background" Value="{DynamicResource DangerSoft}"/>
                            <Setter TargetName="ActionText" Property="Foreground" Value="{DynamicResource Danger}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="applied">
                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SuccessSoft}"/>
                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Success}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                            <!-- лёгкий подъём при наведении -->
                            <Setter TargetName="Card" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.10" Color="{DynamicResource ShadowColor}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- выделенная — рамка акцента, фон прежний: заливка акцентом утяжеляла список -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- навигация слева -->
    <ControlTemplate x:Key="NavCat" TargetType="ListBoxItem">
        <Grid x:Name="Root" Height="32" Background="Transparent" Margin="0,0,0,2">
            <Border x:Name="Bg" CornerRadius="6" Background="Transparent"/>
            <Border x:Name="Pip" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Ic" Style="{StaticResource Glyph}" Text="{Binding Icon}" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock x:Name="N" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}"/>
                <!-- счётчик — пилюлей; полностью выбранная категория — акцентом -->
                <Border x:Name="CntBg" Grid.Column="2" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource PillBg}">
                    <TextBlock x:Name="Cnt" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding CountText}" Value="">
                <Setter TargetName="CntBg" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFull}" Value="True">
                <Setter TargetName="CntBg" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Cnt" Property="Foreground" Value="{DynamicResource AccentFg}"/>
                <Setter TargetName="Cnt" Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHit}" Value="True">
                <Setter TargetName="N" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="Cnt" Property="Foreground" Value="{DynamicResource AccentText}"/>
                <Setter TargetName="Cnt" Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDim}" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="Pip" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource AccentText}"/>
                <Setter TargetName="N" Property="Foreground" Value="{DynamicResource AccentText}"/>
                <Setter TargetName="N" Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="NavHeader" TargetType="ListBoxItem">
        <Grid Height="32" Margin="0,8,0,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" VerticalAlignment="Bottom" Margin="16,0,0,6"/>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="NavSep" TargetType="ListBoxItem">
        <Border Height="1" Margin="16,12" Background="{DynamicResource Border}"/>
    </ControlTemplate>
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template" Value="{StaticResource NavCat}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="header">
                <Setter Property="Template" Value="{StaticResource NavHeader}"/>
                <Setter Property="IsEnabled" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="sep">
                <Setter Property="Template" Value="{StaticResource NavSep}"/>
                <Setter Property="IsEnabled" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== прокрутка: тонкая, без стрелок ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Margin="1,0" Background="{DynamicResource ScrollThumb}"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,0">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Margin="0,1" Background="{DynamicResource ScrollThumb}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== всплывающее: меню наборов, подсказки ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="4" MinWidth="240" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="B" MinHeight="32" CornerRadius="4" Padding="12,4" Background="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="4" Background="{DynamicResource Border}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4" MaxWidth="360">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
